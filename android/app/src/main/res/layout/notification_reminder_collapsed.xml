<?xml version="1.0" encoding="utf-8"?>
<!--
  Collapsed (default) view for the fancy native reminder notification — see
  FancyReminderReceiver.kt. Icon + title + time only; the Complete/Missed
  buttons live on the expanded view (notification_reminder_expanded.xml)
  instead, shown when the user swipes the notification open, matching how
  most action-button notifications are laid out on Android. Shares view ids
  with the expanded layout so FancyReminderReceiver can populate both
  RemoteViews instances identically.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_reminder_card"
    android:padding="14dp">

    <FrameLayout
        android:id="@+id/reminder_icon_square"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_default">

        <TextView
            android:id="@+id/reminder_icon_emoji"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="18sp"
            android:text="🔔"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reminder_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Task title"/>

        <TextView
            android:id="@+id/reminder_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B8B0D4"
            android:textSize="12sp"
            android:text="8:00 AM"/>
    </LinearLayout>
</LinearLayout>
